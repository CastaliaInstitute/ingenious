# Prompt Tuner Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PT_HOST=0.0.0.0
PT_PORT=8002

# Authentication
PT_AUTH_ENABLED=true
PT_JWT_SECRET=your-jwt-secret-here
PT_JWT_EXPIRE_MINUTES=1440

# Admin credentials
PT_ADMIN_EMAIL=admin@prompttuner.local
PT_ADMIN_PASSWORD=your-admin-password-here

# Cosmos DB for trace persistence
PT_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
PT_COSMOS_KEY=your-cosmos-key-here
PT_COSMOS_DATABASE=soca
PT_COSMOS_CONTAINER=traces

# Ingenious Framework Configuration
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__ENABLE=false
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__PASSWORD=not-used

# Ingenious Framework Configuration (Azure OpenAI)
# Use Cognitive Services endpoint format (not OpenAI format)
INGENIOUS_MODELS__0__API_KEY=your-azure-openai-key-here
INGENIOUS_MODELS__0__BASE_URL=https://your-region.api.cognitive.microsoft.com/
INGENIOUS_MODELS__0__MODEL=gpt-4o-mini
INGENIOUS_MODELS__0__DEPLOYMENT=your-deployment-name
INGENIOUS_MODELS__0__API_VERSION=2024-12-01-preview
INGENIOUS_MODELS__0__API_TYPE=rest
INGENIOUS_MODELS__0__ROLE=chat
