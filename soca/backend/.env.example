# SoCa Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
SOCA_PORT=8001
SOCA_HOST=0.0.0.0

# Authentication
SOCA_JWT_SECRET=your-jwt-secret-here

# Admin credentials
SOCA_ADMIN_EMAIL=admin@soca.local
SOCA_ADMIN_PASSWORD=your-admin-password-here

# Azure Cosmos DB
SOCA_COSMOS_URI=https://your-cosmos-account.documents.azure.com:443/
SOCA_COSMOS_KEY=your-cosmos-key-here
SOCA_COSMOS_DATABASE=soca

# Azure Blob Storage
SOCA_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=your-key-here;EndpointSuffix=core.windows.net
SOCA_STORAGE_CONTAINER=soca-submissions

# Prompt Tuner API (hosts AI evaluation via Ingenious)
SOCA_INGENIOUS_API_URL=http://localhost:8002
SOCA_INGENIOUS_API_KEY=
