@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title System Context diagram for Ingenious Multi-Agent AI Framework

Person(dev, "Developer", "Uses Ingenious CLI to configure and deploy")
Person(app_client, "API Client", "Calls Ingenious APIs via HTTP/REST")
Person(end_user, "End User", "Interacts with applications built on Ingenious")

System(ingenious, "Ingenious", "Multi-agent AI framework with FastAPI server\nSupports AutoGen agents, chat flows, knowledge base integration")

System_Ext(azure_openai, "Azure OpenAI", "LLM service for chat completions\nDeployment: gpt-4o-mini")
System_Ext(azure_search, "Azure AI Search", "Vector search for knowledge base retrieval\nSupports semantic and hybrid search")
System_Ext(azure_sql, "Azure SQL Database", "Persistent storage for chat history\nTransaction support with ODBC driver")
System_Ext(cosmos_db, "Azure Cosmos DB", "NoSQL alternative for chat history\nDocument-based storage")
System_Ext(chroma_local, "ChromaDB (Local)", "Local vector database\nEmbeddings storage for knowledge base")
System_Ext(sqlite_local, "SQLite (Local)", "Local relational database\nFor development and testing")
System_Ext(azure_blob, "Azure Blob Storage", "File storage for documents\nSupports knowledge base document uploads")
System_Ext(azure_identity, "Azure Identity", "AAD/MSI authentication\nServicePrincipal, DefaultCredential flows")

Rel(dev, ingenious, "CLI: init, serve, validate")

Rel(app_client, ingenious, "REST API calls: chat, workflows, auth")
Rel(end_user, app_client, "Uses application")

Rel(ingenious, azure_openai, "Chat completions\nText embeddings (gpt-4o-mini)")
Rel(ingenious, azure_search, "Vector search queries\nRetrieves relevant documents")
Rel(ingenious, azure_sql, "CRUD operations\nChat history persistence")
Rel(ingenious, cosmos_db, "Alternative persistence\nDocument storage")
Rel(ingenious, chroma_local, "Vector operations\nLocal embeddings")
Rel(ingenious, sqlite_local, "SQL queries\nDev/test data")
Rel(ingenious, azure_blob, "Document upload/download\nFile storage")
Rel(ingenious, azure_identity, "Token acquisition\nAAD authentication")

@enduml
