@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram for External Service Clients

Component(azure_builder, "AzureClientBuilder", "Abstract base for Azure client construction")
Component(search_builder, "AzureSearchClientBuilder", "Azure AI Search client builder")
Component(openai_builder, "AzureOpenAIChatCompletionClientBuilder", "Azure OpenAI client builder")
Component(sql_builder, "AzureSqlClientBuilder", "Azure SQL client builder")
Component(blob_builder, "BlobServiceClientBuilder", "Azure Blob Storage client builder")
Component(cosmos_builder, "CosmosClientBuilder", "Cosmos DB client builder")
Component(openai_service, "OpenAIService", "Azure OpenAI integration service")
Component(file_storage, "FileStorage", "File storage facade")
Component(local_storage, "LocalFileStorage", "Local filesystem implementation")
Component(azure_storage, "AzureBlobStorage", "Azure Blob implementation")

Rel(search_builder, azure_builder, "Extends")
Rel(openai_builder, azure_builder, "Extends")
Rel(sql_builder, azure_builder, "Extends")
Rel(blob_builder, azure_builder, "Extends")
Rel(cosmos_builder, azure_builder, "Extends")
Rel(openai_service, openai_builder, "Uses")
Rel(file_storage, local_storage, "Uses")
Rel(file_storage, azure_storage, "Uses")
Rel(azure_storage, blob_builder, "Uses")

@enduml
