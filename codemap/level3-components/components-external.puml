@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component diagram for External Services & Clients

Container_Boundary(external, "External Services & Clients") {
    Component(azure_client, "Azure Client Factory", "Azure SDK", "Builds and caches Azure service clients")
    Component(openai_client, "OpenAI Client", "Azure OpenAI", "Azure OpenAI REST client")
    Component(azure_search, "Azure Search Provider", "Retrieval", "Azure AI Search for knowledge base retrieval")
    Component(azure_search_components, "Search Components", "Pipeline", "Pipeline stages (generation, fusion, etc.)")
    Component(retrieval, "Retrieval Module", "Knowledge access", "Abstract retrieval interface")
    Component(blob_client, "Blob Storage Client", "File storage", "Azure Blob Storage SDK client")
    Component(sql_client, "SQL Client", "Database", "Azure SQL Database client")
}

Container_Boundary(agents, "Agent & Conversation Layer") {
    Component(agent_factory, "Agent Factory", "Agent creation", "Creates and configures AutoGen agents")
    Component(kb_agent, "Knowledge Base Agent", "Workflow", "Knowledge base retrieval and synthesis")
    Component(sql_agent, "SQL Manipulation Agent", "Workflow", "SQL query generation and execution")
    Component(classification_agent, "Classification Agent", "Workflow", "Intent and query classification")
    Component(conversation_flows, "Conversation Flows", "Orchestration", "Pluggable conversation patterns")
}

Rel(azure_client, openai_client, "Provides")
Rel(azure_client, azure_search, "Provides")
Rel(azure_client, blob_client, "Provides")
Rel(azure_client, sql_client, "Provides")
Rel(azure_search, azure_search_components, "Uses")
Rel(retrieval, azure_search, "Delegates to")

Rel(agent_factory, kb_agent, "Creates")
Rel(agent_factory, sql_agent, "Creates")
Rel(agent_factory, classification_agent, "Creates")
Rel(conversation_flows, agent_factory, "Uses")
Rel(kb_agent, azure_search, "Uses")
Rel(sql_agent, sql_client, "Uses")

@enduml
