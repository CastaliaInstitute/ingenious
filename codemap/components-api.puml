@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram for API Container

Component(auth_routes, "Auth Routes", "JWT token generation, login, refresh")
Component(chat_routes, "Chat Routes", "Chat endpoint, streaming responses")
Component(conversation_routes, "Conversation Routes", "Thread history retrieval")
Component(custom_workflows, "Custom Workflows Routes", "Workflow invocation, introspection")
Component(message_feedback, "Message Feedback Routes", "Feedback collection, submission")
Component(diagnostic_routes, "Diagnostic Routes", "Health checks, system diagnostics")
Component(prompts_routes, "Prompts Routes", "Prompt management endpoints")
Component(route_manager, "Route Manager", "Route registration and configuration")

Rel(route_manager, auth_routes, "Registers")
Rel(route_manager, chat_routes, "Registers")
Rel(route_manager, conversation_routes, "Registers")
Rel(route_manager, custom_workflows, "Registers")
Rel(route_manager, message_feedback, "Registers")
Rel(route_manager, diagnostic_routes, "Registers")
Rel(route_manager, prompts_routes, "Registers")

@enduml
